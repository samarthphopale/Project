APP_ENV=ec2

# Ollama container
OLLAMA_URL=http://ollama:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text


# Database
POSTGRES_DB=exim
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_PORT=5432
POSTGRES_URL=jdbc:postgresql://postgres:5432/exim

# Chroma
CHROMA_HOST=http://chromadb
CHROMA_PORT=8000

# AI Service
AI_SERVICE_PORT=8000
AI_SERVICE_URL=http://python-ai-service:8000
AI_SERVICE_CHAT_ENDPOINT=/eximAI/chat